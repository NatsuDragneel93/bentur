rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Collection in cui ogni documento appartiene a un utente tramite il campo userId
    function isUserCollection(collection) {
      return collection in [
        'user_todos_personal',
        'user_todos_tour',
        'user_to_buy',
        'user_inventory_personal',
        'manuals',
        'usefulContacts'
      ];
    }

    match /{collection}/{docId} {
      // Lettura ed eliminazione: solo il proprietario
      allow read, delete: if isUserCollection(collection)
        && signedIn()
        && resource.data.userId == request.auth.uid;

      // Creazione: solo a proprio nome
      allow create: if isUserCollection(collection)
        && signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Modifica: solo il proprietario, senza poter cambiare il proprietario
      allow update: if isUserCollection(collection)
        && signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // Tour: ownerId = proprietario, memberIds = chi può vederlo (proprietario compreso).
    // La vecchia collection globale 'tour_artists' non è più accessibile dall'app.
    function tourData(tourId) {
      return get(/databases/$(database)/documents/tours/$(tourId)).data;
    }

    match /tours/{tourId} {
      // Lettura di un singolo tour: membri. Un tour inesistente si può "leggere" (risulta non trovato)
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);

      // Elenco: la query deve filtrare con memberIds array-contains uid
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      // Creazione: a proprio nome e con sé stessi come unico membro
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Modifica: solo il proprietario; non può cedere la proprietà né togliersi dai membri
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      // Artisti del tour: li vedono i membri, li modifica solo il proprietario
      match /artists/{artistId} {
        allow read: if signedIn()
          && request.auth.uid in tourData(tourId).memberIds;

        allow write: if signedIn()
          && tourData(tourId).ownerId == request.auth.uid;

        // Liste dell'artista (Spare, To Do, Consumabili, To Check Before Showtime):
        // le leggono e modificano tutti i membri del tour.
        // Nomi allineati a ARTIST_LIST_SUBCOLLECTIONS in src/services/tours.service.ts
        match /{listName}/{categoryId} {
          allow read, write: if signedIn()
            && listName in ['spare', 'todos', 'consumables', 'showtime_checks']
            && request.auth.uid in tourData(tourId).memberIds;
        }

        // Setup A/B dell'artista (disposizione del palco): un documento per setup.
        // Li leggono e modificano tutti i membri del tour; chi salva deve indicarsi come autore.
        // Nomi e limite allineati a SETUP_DOC_IDS (tours.service.ts) e MAX_STAGE_ELEMENTS (utils/stagePlot.ts)
        match /setups/{setupId} {
          allow read, delete: if signedIn()
            && setupId in ['setupA', 'setupB']
            && request.auth.uid in tourData(tourId).memberIds;

          allow create, update: if signedIn()
            && setupId in ['setupA', 'setupB']
            && request.auth.uid in tourData(tourId).memberIds
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.elements is list
            && request.resource.data.elements.size() <= 500;
        }
      }
    }

    // Tutto ciò che non è elencato sopra è negato
  }
}
